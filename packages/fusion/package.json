{
  "name": "@dsh-forge/fusion",
  "version": "0.1.0",
  "type": "module",
  "main": "./host/index.mjs",
  "exports": {
    ".": "./host/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [],
      "inject": [
        "@botharness/ui",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "license": "MIT"
}
